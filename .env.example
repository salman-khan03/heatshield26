# Optional: enables Gemini-written explanations in the planner ("Explain this recommendation").
# Without it the app serves a deterministic template explanation.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=
# Optional fallback when Gemini is unavailable (Groq, OpenAI-compatible API)
GROQ_API_KEY=
# Optional Groq model override (default: openai/gpt-oss-120b)
GROQ_MODEL=
